# ---------------------------------------------------------------------------
# InsightOS
# ---------------------------------------------------------------------------

# PostgreSQL. In production this should point at the `insights_app` runtime
# role created by migration 0001 — NOT the superuser. The superuser owns the
# tables, and FORCE ROW LEVEL SECURITY is the only thing standing between an
# owner connection and every workspace's data.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/insightos

# Deployment label. Decides whether this deployment may hold REAL customer
# credentials. NOT NODE_ENV — every PaaS sets that to "production" for build
# optimization regardless. Unset behaves as production (fail-closed).
# production | staging | development
APP_ENV=development

# Authentication. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
PUBLIC_APP_URL=http://localhost:3000

# Secret storage. local-aes-gcm is DEVELOPMENT/STAGING ONLY: under
# APP_ENV=production the app refuses to store a customer credential with it.
# Losing the root key makes every stored Odoo credential permanently
# undecryptable. Generate: openssl rand -base64 32 (must decode to 32 bytes)
SECRET_STORE_ADAPTER=local-aes-gcm
SECRET_STORE_ROOT_KEY=

# AI mapping. Without a key the product falls back to the deterministic
# proposer and still produces a complete, reviewable mapping.
OPENAI_API_KEY=

# Feature flags
FEATURE_ODOO_DISCOVERY=1
FEATURE_AI_MAPPING=0
FEATURE_SYNC=1
FEATURE_DASHBOARD_BUILDER=1

# SSRF guard: hosts allowed over plain http / without DNS resolution.
# Local development only — never set this in production.
ODOO_DEV_HOST_ALLOWLIST=

PORT=3000
