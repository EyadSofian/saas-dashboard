# ---------------------------------------------------------------------------
# InsightOS
# ---------------------------------------------------------------------------

# PostgreSQL. In production this should point at the `insights_app` runtime
# role created by migration 0001 — NOT the superuser. The superuser owns the
# tables, and FORCE ROW LEVEL SECURITY is the only thing standing between an
# owner connection and every workspace's data.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/insightos

# Deployment label. Decides whether this deployment may hold REAL customer
# credentials. NOT NODE_ENV — every PaaS sets that to "production" for build
# optimization regardless. Unset behaves as production (fail-closed).
# production | staging | development
APP_ENV=development

# Authentication. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
PUBLIC_APP_URL=http://localhost:3000

# Secret storage.
#
#   local-aes-gcm    development and staging only
#   railway-aes-gcm  the interim production adapter, accepted for the first 1-3
#                    customers. Requires ALLOW_RAILWAY_SECRET_STORE_IN_PRODUCTION=1
#                    to run under APP_ENV=production. Read
#                    docs/runbooks/secret-store.md before enabling it: anyone who
#                    can read this process's environment can decrypt every stored
#                    credential.
#
# LOSING THE ROOT KEY MAKES EVERY STORED ODOO CREDENTIAL PERMANENTLY
# UNDECRYPTABLE. Keep a copy somewhere other than Railway.
#
# Generate: openssl rand -base64 32   (must decode to exactly 32 bytes)
SECRET_STORE_ADAPTER=local-aes-gcm
SECRET_STORE_ROOT_KEY=

# Set only while rotating the root key; remove once re-encryption is complete.
SECRET_STORE_ROOT_KEY_PREVIOUS=

# Required to run railway-aes-gcm under APP_ENV=production. Deliberately has no
# default: setting it is an operator accepting the documented risk.
ALLOW_RAILWAY_SECRET_STORE_IN_PRODUCTION=

# AI mapping. Without a key the product falls back to the deterministic
# proposer and still produces a complete, reviewable mapping.
OPENAI_API_KEY=

# Feature flags
FEATURE_ODOO_DISCOVERY=1
FEATURE_AI_MAPPING=0
FEATURE_SYNC=1
FEATURE_DASHBOARD_BUILDER=1

# SSRF guard: hosts allowed over plain http / without DNS resolution.
# Local development only — never set this in production.
ODOO_DEV_HOST_ALLOWLIST=

PORT=3000

# Email. Without a transport, development prints the link to the console and
# production refuses to start the mailer — it must never log a verification link.
RESEND_API_KEY=
MAIL_FROM=

# Set to 0 only to accept unverified sign-ups (not recommended).
REQUIRE_EMAIL_VERIFICATION=1
