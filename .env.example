# Google Sheet that feeds the dashboard. Must be shared as "anyone with the link".
# Defaults to the Engosoft sheet if unset.
SHEET_ID=14kv8Xkv8SeFhF9roekDI0OKmpZBU29YQOlMj03LOKT0

# --- Durable dashboard storage (Railway PostgreSQL) ------------------------
# On Railway use a service reference such as ${{Postgres.DATABASE_URL}}. The
# public database URL is not required by the app or by n8n.
DATABASE_URL=
# Long random server-only value shared with the n8n Header Auth credential.
# It protects POST /api/ingest/dataset and must never be exposed to the browser.
DASHBOARD_INGEST_SECRET=

# --- Odoo 17 (live) --------------------------------------------------------
# Powers the Products tab and the authoritative CRM/Lost populations. Products
# reads confirmed orders directly; CRM uses active assigned records and Lost
# uses the approved archived-opportunity rules. If Odoo is slow or unavailable,
# CRM/Lost fall back to their Google Sheet copies instead of blanking the app.
# ODOO_API_KEY belongs to ODOO_LOGIN and is never logged or sent to the browser.
ODOO_URL=https://engosoft.com
ODOO_DB=EngoSoft
ODOO_LOGIN=
ODOO_API_KEY=
# Companies to report on — matches `cids=2-3-4` in the Odoo web URLs.
ODOO_COMPANY_IDS=2,3,4
# Earliest Odoo date read by Products and CRM/Lost.
ODOO_START_DATE=2026-01-01

# Optional. Without it the AI assistant still answers the built-in questions
# (best campaign, wasted budget, cheapest CPL, totals, conversion rate, close
# time) from exact figures, but free-form questions are disabled.
OPENAI_API_KEY=

# --- TikTok Marketing API -------------------------------------------------
# Server-only credentials for the authorised TikTok ad accounts. Reports are
# pulled in 30-day chunks and include deleted ads so historical totals reconcile.
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_IDS=
# Defaults to January 1 of the current year when unset.
TIKTOK_START_DATE=
# Optional fixed end date; defaults to today.
TIKTOK_END_DATE=

# --- Google Ads API -------------------------------------------------------
# Server-only OAuth credentials and developer token. Customer IDs may be
# comma-separated and can include dashes; the app normalizes them before use.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CUSTOMER_IDS=
# Defaults to January 1 of the current year when unset.
GOOGLE_ADS_START_DATE=
# Optional fixed end date; defaults to today.
GOOGLE_ADS_END_DATE=

# --- Telegram daily report -------------------------------------------------
# Both must be set for the scheduled report to run. The token is never logged.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Cron expression, evaluated in Africa/Cairo. Default: 09:00 daily.
REPORT_CRON=0 9 * * *

# Report language: ar (default) or en.
REPORT_LANG=ar

# Railway sets this automatically; only needed for local production runs.
PORT=3000

# Where the /start subscriber list is stored. On Railway the container
# filesystem resets on every redeploy, so point this at a mounted volume
# (e.g. /data/telegram-subscribers.json) to keep subscribers.
TELEGRAM_SUBSCRIBERS_FILE=./.data/telegram-subscribers.json

# Public URL of this deployment, used for the link at the end of each Telegram
# report. Leave unset and the link is omitted rather than pointing at a 404.
PUBLIC_APP_URL=

# ---------------------------------------------------------------------------
# Multi-tenant platform (Workspace Onboarding Skeleton)
#
# With every FEATURE_* flag at its default the product behaves exactly as it
# does today; the workspace routes and onboarding UI stay unavailable.
# ---------------------------------------------------------------------------

# Deployment label. Decides whether this deployment may hold REAL customer
# credentials. NOT NODE_ENV — Railway sets that to "production" for build
# optimization regardless. Unset behaves as production (fail-closed).
# production | staging | development
APP_ENV=development

# Feature flags
FEATURE_WORKSPACES=0
FEATURE_ODOO_DISCOVERY=0
FEATURE_LEGACY_DASHBOARD=1

# Authentication (Better Auth — ADR-0001)
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Secret storage (ADR-0002)
# local-aes-gcm is DEVELOPMENT/STAGING ONLY. In production the app refuses to
# store a customer credential under it until a production adapter is configured.
SECRET_STORE_ADAPTER=local-aes-gcm
# Generate: openssl rand -base64 32   (must decode to exactly 32 bytes)
SECRET_STORE_ROOT_KEY=

# SSRF guard: hosts permitted over plain http / without DNS resolution.
# Local development only — never set this in production.
ODOO_DEV_HOST_ALLOWLIST=

# Runtime database role used by the app (created by migration 0001).
# It is NOBYPASSRLS and is NOT the table owner; migrations run as the admin role.
# DATABASE_URL above should point at the runtime role in production.
